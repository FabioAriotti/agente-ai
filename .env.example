# -----------------------------------------------------------------------------
# Secrets for wp-blog-agent. Copy this file to ".env" and fill in real values.
# NEVER commit .env or share it. One WordPress Application Password per client.
#
# The env var NAME must match "wp.appPasswordEnv" in that client's JSON config
# (clients/<name>.json). Example below matches clients/example-client.json.
# -----------------------------------------------------------------------------

# WordPress Application Password for "example-client".
# Generate it in WordPress: Users -> Profile -> Application Passwords.
# Keep the spaces exactly as WordPress shows them (e.g. "abcd EFGH 1234 wxyz ...").
WP_APP_PASSWORD_EXAMPLE_CLIENT="xxxx xxxx xxxx xxxx xxxx xxxx"

# Add one line per additional client, matching their config's appPasswordEnv:
# WP_APP_PASSWORD_CLIENT_TWO="xxxx xxxx xxxx xxxx xxxx xxxx"
